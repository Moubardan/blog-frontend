        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "zod": "^3.23.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^20.14.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@playwright/test": "^1.53.0",
        "eslint": "^8.57.0",
        "eslint-config-next": "^14.2.0",
